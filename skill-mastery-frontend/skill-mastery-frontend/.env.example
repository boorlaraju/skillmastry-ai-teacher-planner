# Spring Boot API base URL (do not include /api if your endpoint config already includes it)
VITE_API_BASE_URL=http://localhost:8080/api
# Adjust these two paths to match your AuthController
VITE_LOGIN_PATH=/auth/login
VITE_REGISTER_PATH=/auth/register
# Optional: localStorage token key used by your backend integration
VITE_TOKEN_KEY=accessToken
